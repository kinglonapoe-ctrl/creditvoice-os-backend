# CreditVoice OS — configuration template.
# Variable NAMES only. Never commit real credentials to this file.

# Telephony provider selection: NONE | TWILIO | SIP
# NONE keeps local development and the whole test suite working without Twilio.
TELEPHONY_PROVIDER=NONE

# Required only when TELEPHONY_PROVIDER=TWILIO.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The public HTTPS origin Twilio signs its requests against, e.g.
# https://project--<id>.lovable.app — no trailing slash. The voice webhook is
# then <TWILIO_WEBHOOK_BASE_URL>/api/public/voice/twilio
TWILIO_WEBHOOK_BASE_URL=

# Backend (managed by the platform; listed for completeness).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
